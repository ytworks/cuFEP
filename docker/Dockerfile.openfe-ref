# syntax=docker/dockerfile:1
#
# Reference image for the cross-check against OpenFE's ABFE protocol (validation only,
# not part of the cuFEP runtime). Stock OpenMM with CUDA; no NVIDIA proprietary runtime.
#
#   docker build -f docker/Dockerfile.openfe-ref -t cufep-openfe-ref:latest docker
#
ARG CUDA_VERSION=13.4.3
FROM nvcr.io/nvidia/cuda:${CUDA_VERSION}-base-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive MAMBA_ROOT_PREFIX=/opt/conda PYTHONUNBUFFERED=1
RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends ca-certificates curl bzip2 \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xj -C /usr/local bin/micromamba
RUN micromamba create -y -n openfe -c conda-forge python=3.12 "openfe>=1.7" cuda-version=13.4 \
 && micromamba clean -a -y
RUN mkdir -p /home/openfe /work && chmod 1777 /home/openfe /work
ENV HOME=/home/openfe PATH=/opt/conda/envs/openfe/bin:${PATH} CONDA_PREFIX=/opt/conda/envs/openfe \
    OPENMM_PLUGIN_DIR=/opt/conda/envs/openfe/lib/plugins OE_LICENSE= MPLBACKEND=Agg
USER 1000:1000
WORKDIR /work
